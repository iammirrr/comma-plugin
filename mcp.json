{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "comma": {
      "type": "streamable-http",
      "url": "https://comma.mirfahad.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["ideas:create"],
            "defaultScopes": ["captures:receipt", "workspace"]
          }
        }
      }
    }
  }
}
